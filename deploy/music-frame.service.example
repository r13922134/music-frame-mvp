[Unit]
Description=Music Frame display API (prototype)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/music-frame
ExecStart=/usr/bin/python3 /home/pi/music-frame/src/frame.py --mode demo --port 8765
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
